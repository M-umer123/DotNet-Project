    <script>
        (function(i, s, o, g, r, a, m)
        {
            i['GoogleAnalyticsObject'] = r;
            i[r] = i[r] || function()
            {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date();
            a = s.createElement(o),
                m = s.getElementsByTagName(o)[0];
            a.async = 1;
            a.src = g;
            m.parentNode.insertBefore(a, m)
        })(window, document, 'script', '../../www.google-analytics.com/analytics.js', 'ga');
        ga('create', 'UA-80463319-4', 'auto');
        ga('send', 'pageview');


          $(document).ready(function () {
            $("#globalSearchBox").on("keyup", function () {
                var value = $(this).val().toLowerCase().trim();
                var contentArea = $("main"); // Only search in main content
                var found = false;

                // Remove old highlights
                contentArea.find(".highlight").each(function () {
                    $(this).replaceWith($(this).text());
                });

                // If search is empty, clear error and stop
                if (value === "") {
                    $("#searchError").hide();
                    return;
                }

                // Search and highlight matches
                contentArea.find("*:not(script):not(style)").each(function () {
                    if ($(this).children().length === 0) {
                        var text = $(this).text();
                        var regex = new RegExp("(" + value + ")", "gi");
                        if (regex.test(text)) {
                            found = true;
                            $(this).html(text.replace(regex, "<span class='highlight'>$1</span>"));
                        }
                    }
                });

                // Show error if nothing found
                if (!found) {
                    $("#searchError").show();
                } else {
                    $("#searchError").hide();
                }
            });
        });


    </script>


   


 

   




    @await RenderSectionAsync("Scripts", required: false)
