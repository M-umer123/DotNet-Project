<article class="content forms-page">

<style>
    /* Elegant Underlined Input Style */

    /* Style all file inputs */
input[type="file"] {
  display: block;
  width: 100%;
  font-size: 15px;
  color: #444;
  cursor: pointer;
  border: none;
  border-bottom: 2px solid #ccc;
  padding: 8px 0;
  background: transparent;
  transition: border-color 0.3s ease;
}

/* Focus + hover effect (blue underline) */
input[type="file"]:hover,
input[type="file"]:focus {
  border-color: #007bff;
  outline: none;
}

/* Hide the default "Choose File" button */
input[type="file"]::-webkit-file-upload-button {
  visibility: hidden;
}

/* Custom button */
input[type="file"]::before {
  content: 'Choose File';
  display: inline-block;
   background: #85CE36;
  color: white;
  padding: 6px 14px;
  border-radius: 4px;
  margin-right: 10px;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.3s ease;
}

/* Hover effect on custom button */
input[type="file"]:hover::before {
   background: #85CE36;
}

/* Show file name when selected */
input[type="file"]:valid::after {
  content: attr(data-file-name);
  color: #333;
}


    .underlined-input {
        border: none;
        border-bottom: 2px solid #ccc;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        transition: all 0.3s ease;
        width: 100%;
        padding: 8px 0;
    }

    .underlined-input:focus {
  border-color: #85CE36;
        outline: none;
    }

    label {
        font-weight: 500;
        color: #555;
        margin-bottom: 4px;
    }

    .product-card {
        padding: 25px;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        margin-bottom: 25px;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
    }

    .product-card h5 {
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
    }

    .btn-save {
            background-color: #85CE36;
        color: #fff;
        border-radius: 8px;
        padding: 6px 14px;
        transition: 0.3s;
    }

    .btn-save:hover {
                background-color: #85CE36;
    }

    .title-block h3 {
        color: #333;
        font-weight: 600;
    }

    .section {
        margin-bottom: 40px;
    }
</style>

